{
  "name": "bandagejs",
  "private": true,
  "description": "Bandage-style pangenome graph viewer in the browser, built on @jbrowse/bandage-core",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --serve",
    "shoot": "node scripts/shoot-readme.mjs",
    "shoot:tutorial": "node scripts/shoot-tutorial.mjs",
    "typecheck": "tsrs --noEmit && tsrs --noEmit -p test",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "deploy": "pnpm build && ./scripts/deploy.sh",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=e2e"
  },
  "devDependencies": {
    "@gmod/tabix": "^3.13.1",
    "@jbrowse/bandage-core": "file:../vendor/walks8-pack/jbrowse-bandage-core-14.0.0-45da3af.tgz",
    "@jbrowse/graph-walks": "file:../vendor/walks8-pack/jbrowse-graph-walks-7.0.0-730e752.tgz",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "generic-filehandle2": "^2.5.1",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "puppeteer-core": "^25.13.0",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "typescript": "^7.0.2"
  }
}
