{
  "name": "bandagejs",
  "private": true,
  "description": "Bandage-style pangenome graph viewer in the browser, built on @jbrowse/bandage-core",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --serve",
    "shoot": "node scripts/shoot-readme.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "pnpm build && ./scripts/deploy.sh",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=e2e"
  },
  "devDependencies": {
    "@gmod/tabix": "^3.10.1",
    "@jbrowse/bandage-core": "^10.2.6",
    "@jbrowse/graph-walks": "^1.1.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "generic-filehandle2": "^2.5.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.13.0",
    "typescript": "^7.0.2"
  }
}
